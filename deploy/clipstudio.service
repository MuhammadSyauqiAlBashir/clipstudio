[Unit]
Description=Clip Studio web/API (FastAPI)
After=network-online.target pocketbase.service
Wants=network-online.target

[Service]
Type=simple
User=clipstudio
Group=clipstudio
WorkingDirectory=/opt/clipstudio
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EnvironmentFile=/etc/clipstudio/env
ExecStart=/opt/clipstudio/venv/bin/uvicorn cs.main:app --app-dir /opt/clipstudio \
  --host 127.0.0.1 --port 8400 --workers 1 \
  --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header --no-access-log
Restart=always
RestartSec=5
UMask=0077
StateDirectory=clipstudio
StateDirectoryMode=0700

MemoryHigh=200M
MemoryMax=350M
TasksMax=64

# Sandbox: read-only system; writable only /var/lib/clipstudio
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true

[Install]
WantedBy=multi-user.target
